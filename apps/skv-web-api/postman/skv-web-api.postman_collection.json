{
  "info": {
    "_postman_id": "c70e9263-113e-44d2-8b14-bd9a1f1960f8",
    "name": "SKV Web API - Implemented Endpoints",
    "description": "Requests for implemented public endpoints through step 105, admin catalogue list/detail (134/135), and catalogue import preflight (138). Set baseUrl and frontendOrigin for your local environment. Admin catalogue endpoints can read drafts without a public origin, media CDN, verified stock or publication. For local admin access, enable DEV_STAFF_AUTH_ENABLED and configure two 32+ character secrets, then set matching devStaffAuthToken and devStaffCsrfToken variables. The enabled staff Principal needs catalogue_read for browsing and catalogue_edit for importing. Existing development Principals are not automatically granted new permissions. This adapter is rejected in production. Import accepts five-sheet JSON, not XLSX uploads; public endpoints still exclude drafts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "frontendOrigin",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "locale",
      "value": "en",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "11111111-1111-4111-8111-111111111111",
      "type": "string"
    },
    {
      "key": "productPath",
      "value": "/en/jewelry/test-ring-999999",
      "type": "string"
    },
    {
      "key": "localityId",
      "value": "replace-with-configured-locality-id",
      "type": "string"
    },
    {
      "key": "requestId",
      "value": "33333333-3333-4333-8333-333333333333",
      "type": "string"
    },
    {
      "key": "devStaffAuthToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "devStaffCsrfToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Internal health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/internal/health",
            "description": "Checks API and database connectivity. configuration_ready is false until shop settings are configured."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Guest session",
      "item": [
        {
          "name": "Create or resume guest session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/guest-session",
            "description": "Returns a CSRF token and expiry, and sets an HttpOnly Secure session cookie. The Origin must match a configured CORS_ORIGINS value. Keep the cookie in Postman's cookie jar for subsequent protected requests."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Dictionaries",
      "item": [
        {
          "name": "List public dictionaries",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/dictionaries?locale={{locale}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dictionaries"
              ],
              "query": [
                {
                  "key": "locale",
                  "value": "{{locale}}"
                }
              ]
            },
            "description": "Returns all public dictionary groups in the requested locale."
          },
          "response": []
        },
        {
          "name": "Filter dictionaries",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/dictionaries?locale={{locale}}&groups=material&groups=gemstone",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dictionaries"
              ],
              "query": [
                {
                  "key": "locale",
                  "value": "{{locale}}"
                },
                {
                  "key": "groups",
                  "value": "material"
                },
                {
                  "key": "groups",
                  "value": "gemstone"
                }
              ]
            },
            "description": "Repeated groups parameters select a subset of public dictionaries."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Resolve public product route",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/resolve?locale={{locale}}&path={{productPath}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "resolve"
              ],
              "query": [
                {
                  "key": "locale",
                  "value": "{{locale}}"
                },
                {
                  "key": "path",
                  "value": "{{productPath}}"
                }
              ]
            },
            "description": "Resolves a current product route or redirects a previous route. Requires a matching published route and PUBLIC_SITE_ORIGIN configuration; unknown routes return 404."
          },
          "response": []
        },
        {
          "name": "Get product detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}?locale={{locale}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "{{productId}}"
              ],
              "query": [
                {
                  "key": "locale",
                  "value": "{{locale}}"
                }
              ]
            },
            "description": "Requires a published product, requested locale translation, current route and approved media. Set fulfilment_method and its matching locality_id or pickup_location_code together when testing a destination context. A missing product returns 404; required public URL/media configuration must be supplied."
          },
          "response": []
        },
        {
          "name": "Get product detail for delivery",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}?locale={{locale}}&fulfilment_method=delivery&locality_id={{localityId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "{{productId}}"
              ],
              "query": [
                {
                  "key": "locale",
                  "value": "{{locale}}"
                },
                {
                  "key": "fulfilment_method",
                  "value": "delivery"
                },
                {
                  "key": "locality_id",
                  "value": "{{localityId}}"
                }
              ]
            },
            "description": "Optional delivery-context example. Replace localityId with a configured locality identifier; locality directory configuration is not currently seeded."
          },
          "response": []
        },
        {
          "name": "List catalogue",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/catalog?locale={{locale}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "catalog"
              ],
              "query": [
                {
                  "key": "locale",
                  "value": "{{locale}}"
                }
              ]
            },
            "description": "Lists published products. Returns an empty 200 response when no products are published."
          },
          "response": []
        },
        {
          "name": "Filter catalogue",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/catalog?locale={{locale}}&product_type=jewellery&sort=price_asc&page=1&page_size=24",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "catalog"
              ],
              "query": [
                {
                  "key": "locale",
                  "value": "{{locale}}"
                },
                {
                  "key": "product_type",
                  "value": "jewellery"
                },
                {
                  "key": "sort",
                  "value": "price_asc"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "24"
                }
              ]
            },
            "description": "Example filtered and sorted catalogue request. Optional supported filters include jewellery_type, selection_id, repeated material_codes/gemstone_codes, price_min/price_max, and fulfilment context."
          },
          "response": []
        },
        {
          "name": "Batch product summaries",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": [\n    \"{{productId}}\"\n  ],\n  \"locale\": \"{{locale}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/products/batch",
            "description": "Returns one ordered result per unique requested UUID. Unknown or unpublished IDs receive a generic unavailable entry. Maximum 50 IDs."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin catalogue",
      "item": [
        {
          "name": "List draft products",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Origin", "value": "{{frontendOrigin}}", "type": "text" },
              { "key": "X-Dev-Staff-Token", "value": "{{devStaffAuthToken}}", "type": "text" },
              { "key": "X-CSRF-Token", "value": "{{devStaffCsrfToken}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/api/admin/catalogue?publication_status=draft&page=1&page_size=24",
            "description": "Requires live catalogue_read permission. Supports optional q (SSG ID or BG/EN draft/current title), publication_status (draft/published/hidden), page and page_size (1..100). Omit publication_status to list all states. Response: items, total, page, page_size. Draft names take precedence over current published names. Copy an item UUID into productId for the detail request. Response is private, no-store."
          },
          "response": []
        },
        {
          "name": "Read admin product and draft",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Origin", "value": "{{frontendOrigin}}", "type": "text" },
              { "key": "X-Dev-Staff-Token", "value": "{{devStaffAuthToken}}", "type": "text" },
              { "key": "X-CSRF-Token", "value": "{{devStaffCsrfToken}}", "type": "text" }
            ],
            "url": "{{baseUrl}}/api/admin/catalogue/{{productId}}",
            "description": "Requires catalogue_read. Returns AdminProduct: draft and matching draft_revision_id (both nullable), published_revision_id, slug_preview, verified units, deduplicated staged_unit_count and actionable validation_errors. No query parameters. Does not create drafts, publish, activate media or promote staged units. Validation errors are read-time checks, not a successful byte-verified publication preflight. Missing UUID returns 404; malformed UUID/unknown query returns 400."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Catalogue import",
      "item": [
        {
          "name": "Stage catalogue import (preflight)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Dev-Staff-Token",
                "value": "{{devStaffAuthToken}}",
                "type": "text"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{devStaffCsrfToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"request_id\": \"{{requestId}}\",\n  \"data\": {\n    \"products\": [],\n    \"units\": [],\n    \"materials\": [],\n    \"images\": [],\n    \"legacy_links\": []\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/admin/catalogue/imports",
            "description": "For local development, requires DEV_STAFF_AUTH_ENABLED=true, configured 32+ character server secrets, an allowed Origin, and the matching X-Dev-Staff-Token/X-CSRF-Token collection variables. The API resolves its fixed development Principal and checks its live enabled state and catalogue_edit permission; callers cannot supply a Principal ID or role. The adapter is disabled in production. Replace the arrays with JSON rows corresponding to the workbook sheets. Empty input creates an invalid preflight report; it never creates products, publishes content, registers media, or activates stock. Same actor/request_id with a changed payload returns 409."
          },
          "response": []
        }
      ]
    }
  ]
}
