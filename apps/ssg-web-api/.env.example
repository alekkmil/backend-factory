NODE_ENV=local
PORT=3001
POSTGRES_USER=skv_web_api
POSTGRES_PASSWORD=local_only_change_me
POSTGRES_DB=skv_web_api_db
POSTGRES_PORT=5433
DATABASE_URL=postgresql://skv_web_api:local_only_change_me@localhost:5433/skv_web_api_db?schema=public
CORS_ORIGINS=http://localhost:3000,https://dev.dwvs3v8mkdpq2.amplifyapp.com
# Use none for cross-site HTTPS frontends; cookies remain Secure and HttpOnly.
SESSION_COOKIE_SAME_SITE=lax
# Same customer checkout code in development and production; no staff authentication.
CHECKOUT_ENABLED=false
CHECKOUT_QUOTE_TTL_SECONDS=
# Stock stays reserved indefinitely. There is no automatic expiry or release.
# Select the test URL outside production; production must use https://3dsgate.borica.bg/cgi-bin/cgi_link.
BORICA_GATEWAY_URL=https://3dsgate-dev.borica.bg/cgi-bin/cgi_link
BORICA_TERMINAL_ID=
BORICA_MERCHANT_ID=
BORICA_MERCHANT_NAME=
BORICA_PRIVATE_KEY_BASE64=
# Base64 of the COMPLETE official gateway PEM (not the merchant key). Use the environment-specific bank key.
BORICA_GATEWAY_PUBLIC_KEY_BASE64=
BORICA_BROWSER_RETURN_URL=
BORICA_REQUEST_TIMEOUT_MS=
PAYMENT_RECONCILE_INTERVAL_SECONDS=
ORDER_ACCESS_URL=
ORDER_ACCESS_ENCRYPTION_KEY_BASE64=
ORDER_ACCESS_GRANT_TTL_SECONDS=
ORDER_ACCESS_SESSION_TTL_SECONDS=
ORDER_ACCESS_LOOKUP_TTL_SECONDS=
TRUST_PROXY=false
PUBLIC_SITE_ORIGIN=http://localhost:3000
MEDIA_CDN_BASE_URL=https://cdn.example.com/
DEV_STAFF_AUTH_ENABLED=false
# Enables development-only media upload/attachment and explicit publication.
DEV_CATALOGUE_PUBLISH_ENABLED=false
# Opt in to production catalogue uploads/publication/visibility and website media uploads.
PROD_CATALOGUE_PUBLISH_ENABLED=false
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_URL=https://your-bucket.s3.eu-central-1.amazonaws.com/
DEV_STAFF_AUTH_TOKEN=
DEV_STAFF_CSRF_TOKEN=
# Production-only Postman access, disabled by default.
PROD_STAFF_AUTH_ENABLED=false
PROD_STAFF_AUTH_TOKEN=
PROD_STAFF_CSRF_TOKEN=
PROD_STAFF_PRINCIPAL_ID=
# Internal stock routes use the configured staff authentication.
# Optional stable source identifier; defaults to dev-staff-stock or prod-staff-stock.
STOCK_FACT_SOURCE_CODE=
OUTBOX_WORKER_ENABLED=false
OUTBOX_CAPTURE_DIRECTORY=
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_LEASE_MS=60000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_MS=5000
OUTBOX_RETRY_MAX_MS=300000
# Outside production every email is prefixed [DEV]; MAIL_TO is required.
# MAIL_TO is a comma-separated list; duplicates are removed case-insensitively.
# Development standard SMTP BCCs MAIL_TO; customer order and staff payment emails do not.
# Local/test SMTP and private capture route to the first MAIL_TO address.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
# Customer order emails use only this account (no fallback to standard SMTP).
# Production checkout requires all purchase settings except the optional display name,
# as well as standard SMTP/MAIL_TO.
# For mail.ssg.bg use port 587 and false (mandatory STARTTLS), or port 465 and true.
# Set PURCHASE_SMTP_FROM to sales@ssg.bg and PURCHASE_SMTP_REPLY_TO to office@ssg.bg.
# Set credentials securely in the deployment environment, never in source control.
PURCHASE_SMTP_HOST=
PURCHASE_SMTP_PORT=
PURCHASE_SMTP_SECURE=
PURCHASE_SMTP_USER=
PURCHASE_SMTP_PASSWORD=
PURCHASE_SMTP_FROM=
PURCHASE_SMTP_FROM_NAME=
PURCHASE_SMTP_REPLY_TO=
LOCAL_TEST_MAIL_ENABLED=false
