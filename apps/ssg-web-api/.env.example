NODE_ENV=local
PORT=3001
POSTGRES_USER=skv_web_api
POSTGRES_PASSWORD=local_only_change_me
POSTGRES_DB=skv_web_api_db
POSTGRES_PORT=5433
DATABASE_URL=postgresql://skv_web_api:local_only_change_me@localhost:5433/skv_web_api_db?schema=public
CORS_ORIGINS=http://localhost:3000,https://dev.dwvs3v8mkdpq2.amplifyapp.com
TRUST_PROXY=false
PUBLIC_SITE_ORIGIN=http://localhost:3000
MEDIA_CDN_BASE_URL=https://cdn.example.com/
DEV_STAFF_AUTH_ENABLED=false
# Enables development-only media upload/attachment and explicit publication.
DEV_CATALOGUE_PUBLISH_ENABLED=false
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_URL=https://your-bucket.s3.eu-central-1.amazonaws.com/
DEV_STAFF_AUTH_TOKEN=
DEV_STAFF_CSRF_TOKEN=
# Internal stock routes use the same development staff authentication.
# Optional stable source identifier; defaults to dev-staff-stock for dev staff.
STOCK_FACT_SOURCE_CODE=
OUTBOX_WORKER_ENABLED=false
OUTBOX_CAPTURE_DIRECTORY=
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_LEASE_MS=60000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_MS=5000
OUTBOX_RETRY_MAX_MS=300000
# Development SMTP delivery is always redirected to MAIL_TO.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
LOCAL_TEST_MAIL_ENABLED=false
