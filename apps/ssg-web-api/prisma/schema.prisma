  productIdRelation            Product?        @relation("Inquiry_productId", fields: [productId], references: [id], onDelete: Restrict)
  contentIdRelation            ContentRecord?  @relation("Inquiry_contentId", fields: [contentId], references: [id], onDelete: Restrict)
  storeCodeRelation            Store?          @relation("Inquiry_storeCode", fields: [storeCode], references: [code], onDelete: Restrict)
  from_OutboxMessage_inquiryId OutboxMessage[] @relation("OutboxMessage_inquiryId")

  @@unique([guestId, requestId])
}

model OutboxMessage {
  id                             String            @id @default(uuid()) @db.Uuid
  dedupeKey                      String            @db.VarChar(255)
  kind                           JobKind
  orderId                        String?           @db.Uuid
  inquiryId                      String?           @db.Uuid
  recipientSnapshot              String?           @db.VarChar(320)
  locale                         Locale?
  templateVersion                String?           @db.VarChar(80)
  payload                        Json
  encryptedSecret                String?           @db.VarChar(4000)
  status                         JobStatus         @default(pending)
  attempts                       Int               @default(0)
  nextAttemptAt                  DateTime?         @db.Timestamptz(3)
  leaseUntil                     DateTime?         @db.Timestamptz(3)
  leaseOwner                     String?           @db.VarChar(128)
  lastError                      String?           @db.VarChar(1000)
  sentAt                         DateTime?         @db.Timestamptz(3)
  providerMessageId              String?           @db.VarChar(255)
  createdAt                      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt                      DateTime          @updatedAt @db.Timestamptz(3)
  orderIdRelation                Order?            @relation("OutboxMessage_orderId", fields: [orderId], references: [id], onDelete: Restrict)
  inquiryIdRelation              Inquiry?          @relation("OutboxMessage_inquiryId", fields: [inquiryId], references: [id], onDelete: Restrict)
  from_StoreCheck_messageId      StoreCheck[]      @relation("StoreCheck_messageId")
  from_DeliveryAttempt_messageId DeliveryAttempt[] @relation("DeliveryAttempt_messageId")

  @@unique([dedupeKey])
  @@index([status, nextAttemptAt, leaseUntil])
}

model StoreCheck {
