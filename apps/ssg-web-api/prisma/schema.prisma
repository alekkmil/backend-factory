  checkedByIdRelation  Principal?     @relation("StoreCheck_checkedById", fields: [checkedById], references: [id], onDelete: Restrict)
  messageIdRelation    OutboxMessage? @relation("StoreCheck_messageId", fields: [messageId], references: [id], onDelete: Restrict)

  @@unique([notificationEventId])
}

model Acceptance {
