  @@unique([messageId, attemptNumber])
}

model AuditEvent {
  id              String             @id @default(uuid()) @db.Uuid
  actorId         String?            @db.Uuid
  guestId         String?            @db.Uuid
  systemActor     String?            @db.VarChar(100)
  action          String             @db.VarChar(100)
  subjectType     String             @db.VarChar(80)
  subjectId       String             @db.VarChar(255)
  reason          RestrictionReason?
  note            String?            @db.VarChar(2000)
  before          Json?
  after           Json?
  eventKey        String             @db.VarChar(255)
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  actorIdRelation Principal?         @relation("AuditEvent_actorId", fields: [actorId], references: [id], onDelete: Restrict)
  guestIdRelation GuestSession?      @relation("AuditEvent_guestId", fields: [guestId], references: [id], onDelete: Restrict)

  @@unique([eventKey])
  @@index([subjectType, subjectId, createdAt])
