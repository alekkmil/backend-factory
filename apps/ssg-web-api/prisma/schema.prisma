  updatedAt                         DateTime      @updatedAt @db.Timestamptz(3)
  from_AccessLookup_actionRequestId AccessLookup? @relation("AccessLookup_actionRequestId")

  @@unique([scopeKey, requestId])
}

model DeliveryAttempt {
  id                String        @id @default(uuid()) @db.Uuid
  messageId         String        @db.Uuid
  attemptNumber     Int
  startedAt         DateTime      @db.Timestamptz(3)
  finishedAt        DateTime?     @db.Timestamptz(3)
  outcome           String?       @db.VarChar(40)
  safeError         String?       @db.VarChar(1000)
